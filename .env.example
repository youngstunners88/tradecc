# Copy this file to .env and fill in real values LOCALLY ONLY.
# .env must never be committed. Add it to .gitignore before it ever
# contains a real value.

# --- RPC ---
HELIUS_API_KEY=

# --- Wallet ---
# In v0.1, load this from your OS-level secrets manager or a locked-down
# runtime env var. If you must use .env for local dev, treat that .env
# as sensitive as the key itself and keep it out of git.
WALLET_PRIVATE_KEY_SECRET_REF=

# --- Mode ---
# backtest | paper | live   (live is gated in code — see mvp_spec.md)
BOT_MODE=paper

# --- Risk defaults ---
POSITION_SIZE_USD=10
MAX_SLIPPAGE_PCT=0.5
DAILY_LOSS_LIMIT_USD=20
PER_TRADE_STOP_LOSS_PCT=5
